# Base URL. Examples:
# "https://generativelanguage.googleapis.com/v1beta/openai/" - for Gemini cloud models
# "http://127.0.0.1:11434/v1/" - for local models via Ollama
LLM_API_URL=""

# API Key
# Important: leave empty (just "") if you are using a local model (Ollama, LM Studio)
LLM_API_KEY_1=""
# LLM_API_KEY_2=""
# LLM_API_KEY_3=""
# ...you can add as many different keys as you want if a cloud LLM is used

# [OPTIONAL] Separate provider for subagents
# If left empty, subagents will use the keys and URL of the main agent (if the subagent system is enabled in settings.yaml)
# SUB_LLM_API_URL="" # For example, the main agent can be given a key and URL from Gemini, and subagents from OpenAI 
# SUB_LLM_API_KEY_1=""

# [OPTIONAL] Global proxy server for all outgoing requests (LLM, GitHub, Email, etc.)
# Format: http://login:pass@ip:port or socks5://login:pass@ip:port
PROXY_URL=""

# [OPTIONAL] Classic bot on Aiogram
AIOGRAM_BOT_TOKEN=""

# [OPTIONAL] User-bot on Telethon
TELETHON_API_ID=""
TELETHON_API_HASH=""

# [OPTIONAL] Github API
GITHUB_TOKEN=""
# To obtain: GitHub -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)

# [OPTIONAL] Email
EMAIL_ACCOUNT="" # Example: agent.jawl@gmail.com
EMAIL_PASSWORD="" # Important: you must use a specially generated "App Password" (with 2FA), not your main email password

# [OPTIONAL] Tavily API
TAVILY_API_KEY=""

# [OPTIONAL] WebHooks
# Choose any complex password
WEBHOOK_SECRET="" 

# [OPTIONAL] ElevenLabs TTS API
# To use the official API, leave the URL empty. For a custom proxy, uncomment:
# ELEVENLABS_API_URL="..."
# ELEVENLABS_API_KEY=""

# [OPTIONAL] Cloud Whisper STT API
# OpenAI-compatible endpoint. To use the official API, leave the URL empty
# CLOUD_WHISPER_API_URL="..."
CLOUD_WHISPER_API_KEY=""